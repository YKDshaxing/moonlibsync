    "rollsum",
    "gzip",
    "zlib",
    "directory-sync",
    "mbundle",
    "ed25519",
    "quorum",
    "x25519",
    "chacha20-poly1305",
    "argon2id",
    "aead",
    "moonbit",
    "esm"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/YKDshaxing/moonlibsync",
